{
  "name": "text-messenger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && shx cp -r .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "next typegen && eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p mock",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "lighthouse": "lhci collect --config=lighthouserc.json && lhci upload --config=lighthouserc.json && lhci assert --config=lighthouserc.json && lhci collect --config=lighthouserc.chat.json && lhci upload --config=lighthouserc.chat.json && lhci assert --config=lighthouserc.chat.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert \"@visual|@showcase\"",
    "test:visual": "docker run --rm --ipc=host --network container:$(docker compose ps -q app) -e CI -e E2E_BASE_URL=http://localhost:3000/text-messenger/ -v \"$(pwd)\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test --project visual",
    "showcase": "playwright test --project showcase && ffmpeg -y -loglevel error -i test-results/showcase/demo.webm -vf \"tpad=stop_mode=clone:stop_duration=1.5,fps=12,scale=960:-1:flags=lanczos,split[frames][palette];[palette]palettegen[palette];[frames][palette]paletteuse\" .github/assets/demo.gif",
    "mock": "node mock/server.ts",
    "knip": "knip",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.13.11",
    "iron-session": "9.0.1",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "xstate": "5.33.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/eslint-plugin": "1.6.27",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-playwright": "2.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer-core": "25.12.0",
    "shx": "0.4.0",
    "size-limit": "14.1.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": "prettier --write"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24"
  }
}
