{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      },
      "startServerCommand": "node lighthouse/serve.mjs",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3200/text-messenger/max",
        "http://localhost:3200/text-messenger/whatsapp",
        "http://localhost:3200/text-messenger/telegram",
        "http://localhost:3200/text-messenger/privacy"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "errors-in-console": ["error", { "maxLength": 0 }],
        "inspector-issues": ["error", { "maxLength": 0 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 396000 }]
      }
    },
    "upload": {
      "outputDir": ".lighthouseci/pages",
      "target": "filesystem"
    }
  }
}
